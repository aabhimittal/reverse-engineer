---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Not found · rex" description="This page does not exist.">
  <section class="wrap" style="padding-block: 80px">
    <h1>No such page</h1>
    <p>Try the <a href={`${base}/`}>home page</a>, the <a href={`${base}/demo/`}>demo</a> or the <a href={`${base}/docs/`}>docs</a>.</p>
  </section>
</Base>
